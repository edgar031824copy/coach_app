# Copy to .env at the repo root for local use (it is git-ignored: never commit it). Nothing loads .env automatically:
# `npm run manual-check -w server` does (it reads the root .env). Real values live in environment variables and
# GitHub/Render/Vercel secrets only. Format: NAME=value, one per line, no spaces around =, no `export`.

# Postgres connection string. Supabase: use the SESSION POOLER string (the direct host is IPv6-only on the free tier).
DATABASE_URL=postgres://user:password@host:5432/dbname

# The one browser origin allowed to call the API (no trailing slash). Local client: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# "real" (default) calls the Anthropic API and needs ANTHROPIC_API_KEY; "fake" is for tests and is refused when NODE_ENV=production.
COACH_MODE=real
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5

# Daily cap on coach calls (positive whole number, default 20) and the server port (default 3000).
MAX_COACH_CALLS_PER_DAY=20
PORT=3000
