{
  "name": "evals",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "evals": "npm run build -w shared --prefix .. && npm run build && node --env-file-if-exists=../.env dist/evals/src/run.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
