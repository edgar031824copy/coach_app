{
  "name": "coach-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
