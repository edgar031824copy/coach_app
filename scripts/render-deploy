#!/usr/bin/env node
// Deploys the server on Render and waits until the deploy is live (deploy spec: order and failure handling).
//
//   RENDER_API_KEY=... RENDER_SERVICE_ID=... [COMMIT_SHA=...] scripts/render-deploy     exit 0 live, 1 failed or timed out, 2 not configured
//
// The repository is public, so the CI log is public: this script prints status names and status codes only. It NEVER prints
// the key, the service id, the API address or a response body.
//
// Optional: RENDER_API_BASE (default https://api.render.com, for tests), RENDER_POLL_MS (default 10000),
// RENDER_DEPLOY_TIMEOUT_MS (default 900000: a build on the free tier is slow).

const key = process.env.RENDER_API_KEY;
const service = process.env.RENDER_SERVICE_ID;
const missing = [!key && 'RENDER_API_KEY', !service && 'RENDER_SERVICE_ID'].filter(Boolean);
if (missing.length) {
  console.error(`render-deploy: ${missing.join(' and ')} must be set.`);
  process.exit(2);
}
const API = (process.env.RENDER_API_BASE ?? 'https://api.render.com').replace(/\/+$/, '');
const POLL_MS = Number(process.env.RENDER_POLL_MS ?? 10_000);
const TIMEOUT_MS = Number(process.env.RENDER_DEPLOY_TIMEOUT_MS ?? 900_000);
const commit = process.env.COMMIT_SHA;
const FAILED = new Set(['build_failed', 'update_failed', 'canceled', 'pre_deploy_failed']);
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

async function call(path, init = {}) {
  const res = await fetch(`${API}${path}`, {
    ...init,
    headers: { Authorization: `Bearer ${key}`, Accept: 'application/json', ...(init.body ? { 'Content-Type': 'application/json' } : {}) },
    signal: AbortSignal.timeout(30_000),
  });
  const text = await res.text();
  let json;
  try { json = JSON.parse(text); } catch { json = undefined; }
  return { status: res.status, json };
}
// Only a code or a name: error messages can contain the address.
const why = (err) => `(${err?.cause?.code ?? err?.name ?? 'Error'})`;
function stop(code, line) {
  console.log(line);
  process.exit(code);
}

// 1. Start the deploy of this commit.
const servicePath = `/v1/services/${encodeURIComponent(service)}/deploys`;
let deployId;
try {
  const started = await call(servicePath, { method: 'POST', body: JSON.stringify(commit ? { commitId: commit } : {}) });
  if (started.status < 200 || started.status >= 300) stop(1, `render-deploy: Render refused to start the deploy (status ${started.status}).`);
  deployId = started.json?.id;
  // Render may answer 202 with no body: then the new deploy is the newest one in the list.
  if (!deployId) {
    const list = await call(`${servicePath}?limit=1`);
    const first = Array.isArray(list.json) ? list.json[0] : undefined;
    deployId = first?.deploy?.id ?? first?.id;
  }
} catch (err) {
  stop(1, `render-deploy: could not start the deploy ${why(err)}.`);
}
if (!deployId) stop(1, 'render-deploy: the new deploy could not be found.');
console.log('render-deploy: deploy started, waiting until it is live.');

// 2. Wait until it is live. A failed or garbled poll is retried until the timeout.
const deadline = Date.now() + TIMEOUT_MS;
let last = 'unknown';
while (Date.now() < deadline) {
  await sleep(POLL_MS);
  try {
    const r = await call(`${servicePath}/${encodeURIComponent(deployId)}`);
    const status = r.status === 200 && typeof r.json?.status === 'string' ? r.json.status : undefined;
    if (status && status !== last) console.log(`render-deploy: status ${status}`);
    if (status) last = status;
    if (status === 'live') stop(0, 'render-deploy: the deploy is live.');
    if (status && FAILED.has(status)) stop(1, `render-deploy: the deploy ended as ${status}.`);
  } catch {
    // transient: try again
  }
}
stop(1, `render-deploy: the deploy did not become live in time (last status: ${last}).`);
