#!/usr/bin/env node
// Test traceability (workflow §8). Derives coverage from the specs and the test tags; stores nothing.
//
// Scenario id:  <capability>/<requirement-slug>/<scenario-slug>   (slug = lowercase, non-alphanumerics -> "-")
// Tags:         @spec(id)  @eval(id)  @manual(id)   anywhere in a file outside openspec/, node_modules/, .claude/
// Checks:       1. every scenario has a tag            (skipped with --report: progress view while building)
//               2. every tag names a real scenario     (typo guard)
//               3. no tag that exists on master was removed (the "later epic loosens an earlier test" guard)
// Usage:        scripts/trace [--report] [--base <git-ref>]     exit 1 on any failed check
import { readFileSync, readdirSync, statSync, existsSync } from 'node:fs';
import { join, relative, sep } from 'node:path';
import { execFileSync } from 'node:child_process';

const ROOT = join(import.meta.dirname, '..');
const args = process.argv.slice(2);
const report = args.includes('--report');
const base = args.includes('--base') ? args[args.indexOf('--base') + 1] : 'master';

const slug = (s) => s.toLowerCase().replace(/[`'"]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

function* walk(dir) {
  for (const name of readdirSync(dir)) {
    const p = join(dir, name);
    if (statSync(p).isDirectory()) yield* walk(p); else yield p;
  }
}

// 1. Scenarios: canonical specs plus every open (non-archived) change.
const specFiles = [];
const canon = join(ROOT, 'openspec/specs');
if (existsSync(canon)) for (const p of walk(canon)) if (p.endsWith(sep + 'spec.md')) specFiles.push(p);
const changes = join(ROOT, 'openspec/changes');
if (existsSync(changes)) {
  for (const c of readdirSync(changes)) {
    if (c === 'archive') continue;
    const sd = join(changes, c, 'specs');
    if (existsSync(sd)) for (const p of walk(sd)) if (p.endsWith(sep + 'spec.md')) specFiles.push(p);
  }
}
const scenarios = new Map(); // id -> spec file
const errors = [];
for (const f of specFiles) {
  const cap = relative(ROOT, f).split(sep).slice(-2, -1)[0];
  let req = null;
  for (const line of readFileSync(f, 'utf8').split('\n')) {
    let m;
    if ((m = line.match(/^### Requirement:\s*(.+?)\s*$/))) req = slug(m[1]);
    else if ((m = line.match(/^#### Scenario:\s*(.+?)\s*$/)) && req) {
      const id = `${cap}/${req}/${slug(m[1])}`;
      if (scenarios.has(id) && scenarios.get(id) !== f) { /* same capability in canon and change: same scenario */ }
      else if (scenarios.has(id)) errors.push(`duplicate scenario id ${id}`);
      scenarios.set(id, f);
    }
  }
}

// 2. Tags in the working tree.
const TAG = /@(?:spec|eval|manual)\(([a-z0-9-]+\/[a-z0-9-]+\/[a-z0-9-]+)\)/g;
const SKIP = new Set(['node_modules', '.git', 'openspec', '.claude', 'dist', 'build', 'coverage', 'evals/results']);
const tagged = new Map(); // id -> [files]
function scan(dir) {
  for (const name of readdirSync(dir)) {
    if (SKIP.has(name)) continue;
    const p = join(dir, name);
    if (statSync(p).isDirectory()) { scan(p); continue; }
    if (p === join(ROOT, 'scripts/trace') || p.endsWith('.md') && relative(ROOT, p).startsWith('docs/')) continue;
    let text; try { text = readFileSync(p, 'utf8'); } catch { continue; }
    for (const m of text.matchAll(TAG)) {
      if (!tagged.has(m[1])) tagged.set(m[1], []);
      tagged.get(m[1]).push(relative(ROOT, p));
    }
  }
}
scan(ROOT);

const uncovered = [...scenarios.keys()].filter((id) => !tagged.has(id));
const unknown = [...tagged.keys()].filter((id) => !scenarios.has(id));

// 3. Tags that exist on the base ref but are gone now.
let removed = [];
try {
  const out = execFileSync('git', ['grep', '-h', '-o', '-E', '@(spec|eval|manual)\\([a-z0-9/-]+\\)', base, '--', '.', ':!openspec', ':!docs', ':!.claude', ':!scripts'],
    { cwd: ROOT, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
  const onBase = new Set([...out.matchAll(TAG)].map((m) => m[1]));
  removed = [...onBase].filter((id) => !tagged.has(id));
} catch { /* no matches on base, or no such ref yet: nothing to compare */ }

const covered = scenarios.size - uncovered.length;
console.log(`scenarios: ${scenarios.size}  covered: ${covered}  uncovered: ${uncovered.length}  tags: ${tagged.size}`);
if (!report && uncovered.length) { console.log('\nUncovered scenarios:'); uncovered.forEach((i) => console.log('  ' + i)); errors.push(`${uncovered.length} scenario(s) without a test tag`); }
if (unknown.length) { console.log('\nTags that match no scenario:'); unknown.forEach((i) => console.log(`  ${i}  (${tagged.get(i)[0]})`)); errors.push(`${unknown.length} unknown tag(s)`); }
if (removed.length) { console.log(`\nTags present on ${base} but missing now:`); removed.forEach((i) => console.log('  ' + i)); errors.push(`${removed.length} tag(s) removed since ${base}`); }
if (errors.length) { console.error('\nFAIL: ' + errors.join('; ')); process.exit(1); }
console.log(report ? 'OK (report mode: uncovered scenarios not enforced)' : 'OK');
